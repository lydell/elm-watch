{
  "private": true,
  "name": "build",
  "type": "module",
  "imports": {
    "#fake-elm": "./tests/FakeElm.js",
    "#spawn": "./tests/Spawn.js"
  },
  "scripts": {
    "install-test-elm-dependencies": "tsx scripts/InstallTestDependencies.ts",
