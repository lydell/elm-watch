  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/ws": "8.5.14",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/eslint-plugin": "1.1.27",
    "elm": "0.19.1-6",
    "elm-format": "0.8.8",
    "esbuild": "0.28.2",
    "eslint": "9.32.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.14.0",
    "jsdom": "26.0.0",
    "oxfmt": "0.74.0",
    "run-pty": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "typescript-eslint": "8.23.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "chokidar": "^3.5.3",
    "tiny-decoders": "^23.0.0",
    "ws": "^8.18.0"
