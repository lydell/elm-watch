#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { fakeElm, realElm, waitUntil } from "#fake-elm";

const lockFile = path.join(import.meta.dirname, "..", "..", "lock");

// When `lock` says “Delay”, acknowledge it and wait for it to say “Normal”
// before exiting.
async function delayed() {
  const exitCode = await realElm();
  if (fs.readFileSync(lockFile, "utf8") === "Delay") {
    fs.writeFileSync(lockFile, "DelayAck");
    await waitUntil(() => fs.readFileSync(lockFile, "utf8") === "Normal");
  }
  return exitCode;
}

fakeElm({
  install: delayed,
  make: delayed,
});
