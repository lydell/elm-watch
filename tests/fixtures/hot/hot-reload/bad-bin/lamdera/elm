#!/usr/bin/env node
// Runs `lamdera` instead of `elm`. Lamdera ships with the `hot-reload-stop`
// branches of lydell/core, lydell/browser and lydell/virtual-dom, which have
// built-in hot reloading (`Elm.hot`).
import { spawn } from "#spawn";

const child = spawn("lamdera", process.argv.slice(2), { stdio: "inherit" });

child.on("error", (error) => {
  process.stderr.write(`Failed to run lamdera: ${error.stack}`);
  process.exit(1);
});

child.on("exit", (exitCode) => {
  process.exit(exitCode ?? 1);
});
