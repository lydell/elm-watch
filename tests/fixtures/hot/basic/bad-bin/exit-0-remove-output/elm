#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { fakeElm, isTypecheckOnly, realElm } from "#fake-elm";

fakeElm({
  make: async () => {
    const exitCode = await realElm();
    if (!isTypecheckOnly) {
      const dir = path.join(
        import.meta.dirname,
        "..",
        "..",
        "elm-stuff",
        "elm-watch",
      );
      fs.rmSync(dir, { recursive: true });
    }
    return exitCode;
  },
});
