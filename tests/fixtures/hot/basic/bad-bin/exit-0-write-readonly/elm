#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { fakeElm, isTypecheckOnly, realElm } from "#fake-elm";

fakeElm({
  make: async () => {
    const exitCode = await realElm();
    if (!isTypecheckOnly) {
      const file = path.join(
        import.meta.dirname,
        "..",
        "..",
        "build",
        "Readonly.js",
      );
      fs.chmodSync(file, "0444"); // readonly
    }
    return exitCode;
  },
});
