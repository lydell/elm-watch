#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { call, fakeElm, hang, realElm } from "#fake-elm";

const elmJsonPath = path.join(import.meta.dirname, "..", "..", "elm.json");
const inputPath = path.join(import.meta.dirname, "..", "..", "src", "Main.elm");
const lockPath = path.join(import.meta.dirname, "..", "..", "lock");
const interruptedPath = path.join(
  import.meta.dirname,
  "..",
  "..",
  "elm-stuff",
  "0.19.3",
  "Interrupted.elmo",
);

function touch(filePath) {
  const now = new Date();
  fs.utimesSync(filePath, now, now);
}

function elmWork() {
  const lockFile = fs.readFileSync(lockPath, "utf8");
  if (lockFile === "LockAll") {
    // Hang on install. Switch to hanging on compile or typecheck only.
    fs.writeFileSync(lockPath, "LockExceptInstall");
    touch(elmJsonPath);
    return hang();
  } else if (lockFile === "LockExceptInstall" && call !== "install") {
    // Hang on compile or typecheck only. Switch to succeeding.
    fs.writeFileSync(lockPath, "NoLock");
    touch(inputPath);
    // Like a half-written file when the real `elm` is killed. elm-watch
    // should remove it.
    fs.mkdirSync(path.dirname(interruptedPath), { recursive: true });
    fs.writeFileSync(interruptedPath, "half");
    return hang();
  } else {
    return realElm();
  }
}

fakeElm({
  install: elmWork,
  make: elmWork,
});
