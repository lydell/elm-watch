#!/usr/bin/env node
import fs from "fs";
import path from "path";
import { args, fakeElm, realElm, waitUntil } from "#fake-elm";

const lock = path.join(import.meta.dirname, "..", "lock");

function canExit() {
  return fs.readFileSync(lock, "utf8") === "typecheck-only-ok-to-exit";
}

fakeElm({
  make: async () => {
    if (!args.some((arg) => arg.includes("Main"))) {
      return realElm();
    }
    if (!canExit()) {
      fs.writeFileSync(lock, "typecheck-only-started");
    }
    const exitCode = await realElm();
    await waitUntil(canExit);
    return exitCode;
  },
});
